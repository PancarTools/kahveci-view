{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "KahveciView",
	"version": "0.1.0",
	"identifier": "com.utkutekalmaz.kahveci-view",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "KahveciView",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"decorations": false,
				"titleBarStyle": "Overlay"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$HOME/**", "$DESKTOP/**", "$DOWNLOAD/**", "$PICTURE/**", "$DOCUMENT/**"]
			}
		}
	},
	"plugins": {},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"fileAssociations": [
			{
				"ext": ["jpg", "jpeg"],
				"name": "JPEG Image",
				"role": "Viewer",
				"mimeType": "image/jpeg"
			},
			{
				"ext": ["png"],
				"name": "PNG Image",
				"role": "Viewer",
				"mimeType": "image/png"
			},
			{
				"ext": ["gif"],
				"name": "GIF Image",
				"role": "Viewer",
				"mimeType": "image/gif"
			},
			{
				"ext": ["webp"],
				"name": "WebP Image",
				"role": "Viewer",
				"mimeType": "image/webp"
			},
			{
				"ext": ["bmp"],
				"name": "Bitmap Image",
				"role": "Viewer",
				"mimeType": "image/bmp"
			},
			{
				"ext": ["tiff", "tif"],
				"name": "TIFF Image",
				"role": "Viewer",
				"mimeType": "image/tiff"
			}
		]
	}
}
