{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "KahveciView",
	"version": "0.1.0",
	"identifier": "com.utkutekalmaz.kahveci-view",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "KahveciView",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"decorations": false,
				"titleBarStyle": "Overlay"
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$HOME/**", "$DESKTOP/**", "$DOWNLOAD/**", "$PICTURE/**", "$DOCUMENT/**"]
			}
		}
	},
	"plugins": {},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"fileAssociations": [
			{
				"ext": ["jpg", "jpeg"],
				"name": "JPEG Image",
				"role": "Viewer",
				"mimeType": "image/jpeg"
			},
			{
				"ext": ["png"],
				"name": "PNG Image",
				"role": "Viewer",
				"mimeType": "image/png"
			},
			{
				"ext": ["gif"],
				"name": "GIF Image",
				"role": "Viewer",
				"mimeType": "image/gif"
			},
			{
				"ext": ["webp"],
				"name": "WebP Image",
				"role": "Viewer",
				"mimeType": "image/webp"
			},
			{
				"ext": ["bmp"],
				"name": "Bitmap Image",
				"role": "Viewer",
				"mimeType": "image/bmp"
			},
			{
				"ext": ["tiff", "tif"],
				"name": "TIFF Image",
				"role": "Viewer",
				"mimeType": "image/tiff"
			},
			{
				"ext": ["svg"],
				"name": "SVG Image",
				"role": "Viewer",
				"mimeType": "image/svg+xml"
			},
			{
				"ext": ["heic", "heif"],
				"name": "HEIF Image",
				"role": "Viewer",
				"mimeType": "image/heif"
			},
			{
				"ext": ["avif"],
				"name": "AVIF Image",
				"role": "Viewer",
				"mimeType": "image/avif"
			},
			{
				"ext": ["jxl"],
				"name": "JPEG XL Image",
				"role": "Viewer",
				"mimeType": "image/jxl"
			},
			{
				"ext": ["ico"],
				"name": "Icon File",
				"role": "Viewer",
				"mimeType": "image/x-icon"
			},
			{
				"ext": ["icns"],
				"name": "macOS Icon",
				"role": "Viewer",
				"mimeType": "image/x-icns"
			},
			{
				"ext": ["psd"],
				"name": "Photoshop Document",
				"role": "Viewer",
				"mimeType": "image/vnd.adobe.photoshop"
			},
			{
				"ext": ["tga"],
				"name": "TGA Image",
				"role": "Viewer",
				"mimeType": "image/x-tga"
			},
			{
				"ext": ["exr"],
				"name": "OpenEXR Image",
				"role": "Viewer",
				"mimeType": "image/x-exr"
			},
			{
				"ext": ["hdr"],
				"name": "HDR Image",
				"role": "Viewer",
				"mimeType": "image/vnd.radiance"
			},
			{
				"ext": ["pic", "pct"],
				"name": "PICT Image",
				"role": "Viewer",
				"mimeType": "image/x-pict"
			},
			{
				"ext": ["qoi"],
				"name": "QOI Image",
				"role": "Viewer",
				"mimeType": "image/x-qoi"
			},
			{
				"ext": ["jng"],
				"name": "JNG Image",
				"role": "Viewer",
				"mimeType": "image/x-jng"
			},
			{
				"ext": ["mng"],
				"name": "MNG Image",
				"role": "Viewer",
				"mimeType": "video/x-mng"
			}
		]
	}
}
