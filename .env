# Optional: dev-only auto-load image path
# If unset/empty, the app will NOT auto-open any image on startup.
#
# Example:
# PUBLIC_DEV_AUTOLOAD_IMAGE_PATH=/Users/you/Pictures/test.jpg
PUBLIC_DEV_AUTOLOAD_IMAGE_PATH=/Users/utkutekalmaz/Downloads/profile.jpg

# Preview strategy for large images (affects initial decode size and perceived navigation speed)
# Values: off | aggressive | progressive
PUBLIC_PREVIEW_MODE=progressive

# Large-image thresholds (either condition matching will apply the selected preview mode)
PUBLIC_PREVIEW_LARGE_IMAGE_BYTES=12000000
PUBLIC_PREVIEW_LARGE_IMAGE_MEGAPIXELS=10

# aggressive mode: cap preview decode width
PUBLIC_PREVIEW_AGGRESSIVE_MAX_WIDTH=2048

# progressive mode: stage1 decode first, then stage2 upgrade in idle time
PUBLIC_PREVIEW_PROGRESSIVE_STAGE1_WIDTH=1024
PUBLIC_PREVIEW_PROGRESSIVE_STAGE2_WIDTH=2048

# Minimap overlay feature flag (values: true | false)
PUBLIC_MINIMAP_ENABLED=false