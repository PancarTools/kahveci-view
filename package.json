{
	"name": "kahveci-view",
	"version": "0.1.0",
	"description": "Modern image viewer and editor - an IrfanView alternative built with Tauri 2 and Svelte 5",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start": "tauri dev",
		"app": "tauri dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"tauri": "tauri"
	},
	"license": "MIT",
	"dependencies": {
		"@tailwindcss/vite": "^4.1.17",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.4.2",
		"@tauri-apps/plugin-fs": "^2.4.4",
		"@tauri-apps/plugin-opener": "^2",
		"tailwindcss": "^4.1.17"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.6",
		"@sveltejs/kit": "^2.49.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tauri-apps/cli": "^2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "~5.6.2",
		"vite": "^6.0.3"
	}
}
